  {
    "id": "REAS-ANA-014",
    "subject": "reasoning",
    "topic": "analogy",
    "difficulty": 4,
    "question": "24 : 126 :: 48 : ?",
    "options": [
      {
        "id": "A",
        "text": "342"
      },
      {
        "id": "B",
        "text": "343"
      },
      {
        "id": "C",
        "text": "344"
      },
      {
        "id": "D",
        "text": "345"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "24 = 5^2 - 1, 126 = 5^3 + 1. 48 = 7^2 - 1, so next is 7^3 + 1 = 343 + 1 = 344.",
      "steps": [
        "n^2 - 1 : n^3 + 1.",
        "7^3 + 1 = 344."
      ],
      "methods": [
        {
          "name": "Square-Cube Pair",
          "steps": [
            "5^2 - 1 : 5^3 + 1 :: 7^2 - 1 : 7^3 + 1 = 344."
          ]
        }
      ],
      "exam_tip": "Pattern: n^2 - 1 : n^3 + 1."
    }
  },
