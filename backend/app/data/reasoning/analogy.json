    "subject": "reasoning",
    "topic": "analogy",
    "difficulty": 5,
    "question": "68 : 130 :: ? : 350",
    "options": [
      {
        "id": "A",
        "text": "210"
      },
      {
        "id": "B",
        "text": "216"
      },
      {
        "id": "C",
        "text": "222"
      },
      {
        "id": "D",
        "text": "240"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "68 = 4^3 + 4. 130 = 5^3 + 5. 350 = 7^3 + 7. The missing term is 6^3 + 6 = 216 + 6 = 222.",
      "steps": [
        "n^3 + n series: 4, 5, 6, 7.",
        "6^3 + 6 = 222."
      ],
      "methods": [
        {
          "name": "n^3 + n Rule",
          "steps": [
            "216 + 6 = 222."
          ]
        }
      ],
      "exam_tip": "n^3 + n is a favorite SSC CGL Tier-I pattern."
    }
  },
