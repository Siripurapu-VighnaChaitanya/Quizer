      },
      {
        "id": "D",
        "text": "28"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "Prime factorization: 360 = 2^3 * 3^2 * 5^1. Number of factors = (3+1)(2+1)(1+1) = 4 * 3 * 2 = 24.",
      "steps": [
        "360 = 2^3 * 3^2 * 5^1.",
        "Factors = (3+1)(2+1)(1+1) = 24."
      ],
      "methods": [
        {
          "name": "Factor Formula",
          "steps": [
            "(p+1)(q+1)(r+1) = 4 * 3 * 2 = 24."
          ]
        }
      ],
      "exam_tip": "If N = a^p * b^q * c^r, total factors = (p+1)(q+1)(r+1)."
    }
  },
  {
