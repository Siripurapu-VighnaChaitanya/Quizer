  {
    "id": "MATH-NS-009",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 3,
    "question": "If 738A6A is divisible by 11, find the value of digit A.",
    "options": [
      {
        "id": "A",
        "text": "3"
      },
      {
        "id": "B",
        "text": "6"
      },
      {
        "id": "C",
        "text": "7"
      },
      {
        "id": "D",
        "text": "9"
      }
    ],
    "correct_option": "D",
    "explanation": {
      "simple": "Sum of odd places = A + A + 3 = 2A + 3. Sum of even places = 6 + 8 + 7 = 21. Difference = 21 - (2A + 3) = 18 - 2A. For divisibility by 11: 18 - 2A = 0 or 11. 18 - 2A = 0 -> A = 9.",
      "steps": [
        "Even sum = 21.",
        "Odd sum = 2A + 3.",
        "21 - (2A + 3) = 0 -> 2A = 18 -> A = 9."
      ],
      "methods": [
        {
          "name": "Divisibility by 11",
          "steps": [
            "18 - 2A = 0 -> A = 9."
          ]
        }
      ],
      "exam_tip": "Difference between odd and even place sums must be 0 or a multiple of 11."
    }
  },
