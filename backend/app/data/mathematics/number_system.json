  {
    "id": "MATH-NS-013",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 4,
    "question": "Find the remainder when (67^67 + 67) is divided by 68.",
    "options": [
      {
        "id": "A",
        "text": "1"
      },
      {
        "id": "B",
        "text": "66"
      },
      {
        "id": "C",
        "text": "67"
      },
      {
        "id": "D",
        "text": "0"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "67 ≡ -1 (mod 68). (-1)^67 + 67 = -1 + 67 = 66 mod 68.",
      "steps": [
        "67 = 68 - 1 ≡ -1 mod 68.",
        "(-1)^67 = -1.",
        "-1 + 67 = 66."
      ],
      "methods": [
        {
          "name": "Negative Remainder",
          "steps": [
            "(-1)^67 + (-1) = -2 ≡ 66 mod 68."
          ]
        }
      ],
      "exam_tip": "Use negative remainders: (n - 1) ≡ -1 mod n."
    }
  },
  {
    "id": "MATH-NS-014",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 4,
    "question": "How many natural numbers less than 1,000 are not divisible by either 5 or 7?",
    "options": [
      {
        "id": "A",
        "text": "685"
      },
      {
        "id": "B",
        "text": "686"
      },
      {
        "id": "C",
        "text": "687"
      },
      {
        "id": "D",
        "text": "688"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Total = 999. Divisible by 5: 999 // 5 = 199. By 7: 999 // 7 = 142. By both (35): 999 // 35 = 28. Divisible by 5 or 7 = 199 + 142 - 28 = 313. Not divisible = 999 - 313 = 686.",
      "steps": [
        "Divisible by 5 or 7 = 199 + 142 - 28 = 313.",
        "999 - 313 = 686."
      ],
      "methods": [
        {
          "name": "Inclusion-Exclusion",
          "steps": [
            "Total - (N5 + N7 - N35) = 999 - 313 = 686."
          ]
        }
      ],
      "exam_tip": "Principle of Inclusion-Exclusion: n(A U B) = n(A) + n(B) - n(A ∩ B)."
    }
  },
