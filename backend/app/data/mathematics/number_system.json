  {
    "id": "MATH-NS-017",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 5,
    "question": "If x is a positive integer such that (x^2 + 2x + 7) is divisible by (x + 1), find the number of possible values of x.",
    "options": [
      {
        "id": "A",
        "text": "2"
      },
      {
        "id": "B",
        "text": "3"
      },
      {
        "id": "C",
        "text": "4"
      },
      {
        "id": "D",
        "text": "5"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "(x^2 + 2x + 7)/(x + 1) = (x(x+1) + (x+1) + 6)/(x+1) = x + 1 + 6/(x+1). For this to be an integer, (x + 1) must be a factor of 6. Positive factors of 6 are 1, 2, 3, 6. Since x >= 1, x+1 >= 2, so x+1 can be 2, 3, 6 (3 values)... wait, if factors are 1, 2, 3, 6: x+1=2 -> x=1; x+1=3 -> x=2; x+1=6 -> x=5. That's 3 values. If x is any integer, but question says positive integer: 3 values. Wait, let's check option A=2, B=4? If x=0 is included it's 4. If x is positive integer: 3. Let's make options 1, 2, 3, 4.",
      "steps": [
        "6 / (x+1) must be integer.",
        "Factors of 6: 2, 3, 6 -> 3 values.",
        "x = 1, 2, 5."
      ],
      "methods": [
        {
          "name": "Algebraic Division",
          "steps": [
            "(x+1) divides 6 -> 3 positive integer solutions."
          ]
        }
      ],
      "exam_tip": "Divide polynomial and find factors of remainder."
    }
  },
  {
    "id": "MATH-NS-018",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 5,
    "question": "Find the last two digits of the number 3^400.",
    "options": [
      {
        "id": "A",
        "text": "01"
      },
      {
        "id": "B",
        "text": "03"
      },
      {
        "id": "C",
        "text": "09"
      },
      {
        "id": "D",
        "text": "27"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "3^4 = 81. 3^20 = (3^4)^5 = 81^5 ends in 01 mod 100. Since 400 is a multiple of 20, 3^400 ≡ (3^20)^20 ≡ 1^20 ≡ 01 (mod 100).",
      "steps": [
        "3^20 mod 100 = 1.",
        "(3^20)^20 = 1^20 = 01."
      ],
      "methods": [
        {
          "name": "Euler's Totient",
          "steps": [
            "phi(100) = 40. 3^40 = 1 mod 100 -> 3^400 = (3^40)^10 = 1 = 01."
          ]
        }
      ],
      "exam_tip": "Euler's totient for 100 is 40. Since gcd(3, 100)=1, 3^40 ≡ 1 mod 100."
    }
  },
  {
    "id": "MATH-NS-019",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 5,
    "question": "What is the remainder when (1! + 2! + 3! + ... + 100!) is divided by 8?",
    "options": [
      {
        "id": "A",
        "text": "1"
      },
      {
        "id": "B",
        "text": "3"
      },
      {
        "id": "C",
        "text": "5"
      },
      {
        "id": "D",
        "text": "7"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "4! = 24 is divisible by 8. All subsequent factorials (5!, 6!...) contain 4! and are divisible by 8. We only need: (1! + 2! + 3!) mod 8 = (1 + 2 + 6) mod 8 = 9 mod 8 = 1... wait, 1 + 2 + 6 = 9 = 1 mod 8! Option A is 1!",
      "steps": [
        "4! and above are multiples of 8.",
        "1! + 2! + 3! = 1 + 2 + 6 = 9.",
        "9 mod 8 = 1."
      ],
      "methods": [
        {
          "name": "Factorial Cutoff",
          "steps": [
            "Terms >= 4! have factor 8. Only test 1! + 2! + 3! = 9 -> Remainder 1."
          ]
        }
      ],
      "exam_tip": "All factorials >= 4! are completely divisible by 8."
    }
  },
  {
    "id": "MATH-NS-020",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 5,
    "question": "How many ordered pairs of positive integers (a, b) satisfy 1/a + 1/b = 1/6?",
    "options": [
      {
        "id": "A",
        "text": "7"
      },
      {
        "id": "B",
        "text": "9"
      },
      {
        "id": "C",
        "text": "10"
      },
      {
        "id": "D",
        "text": "12"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Rewrite as (a - 6)(b - 6) = 36. Number of pairs equals number of factors of 36. 36 = 2^2 * 3^2 -> (2+1)(2+1) = 3 * 3 = 9 factors. Hence exactly 9 positive pairs.",
      "steps": [
        "(a - 6)(b - 6) = 36.",
        "Factors of 36 = 9.",
        "Total pairs = 9."
      ],
      "methods": [
        {
          "name": "Simon's Favorite Factoring Trick",
          "steps": [
            "ab - 6a - 6b = 0 -> (a-6)(b-6) = 36 -> 9 factor pairs."
          ]
        }
      ],
      "exam_tip": "1/a + 1/b = 1/n transforms into (a - n)(b - n) = n^2."
    }
  }
]