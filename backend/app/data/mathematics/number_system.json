    "question": "Find the unit digit in the product 784 * 618 * 917 * 463.",
    "options": [
      {
        "id": "A",
        "text": "2"
      },
      {
        "id": "B",
        "text": "4"
      },
      {
        "id": "C",
        "text": "6"
      },
      {
        "id": "D",
        "text": "8"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "Multiply unit digits: 4 * 8 = 32 (unit 2). 2 * 7 = 14 (unit 4). 4 * 3 = 12 (unit 2).",
      "steps": [
        "4 * 8 = 32 -> 2",
        "2 * 7 = 14 -> 4",
        "4 * 3 = 12 -> 2."
      ],
      "methods": [
        {
          "name": "Unit Digit Rule",
          "steps": [
            "(4 * 8 * 7 * 3) mod 10 = (32 * 21) mod 10 = (2 * 1) = 2."
          ]
        }
      ],
      "exam_tip": "Multiply only unit digits sequentially mod 10."
    }
