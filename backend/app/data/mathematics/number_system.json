  {
    "id": "MATH-NS-005",
    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 2,
    "question": "What is the remainder when 2^31 is divided by 5?",
    "options": [
      {
        "id": "A",
        "text": "1"
      },
      {
        "id": "B",
        "text": "2"
      },
      {
        "id": "C",
        "text": "3"
      },
      {
        "id": "D",
        "text": "4"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "Powers of 2 mod 5: 2^1=2, 2^2=4, 2^3=8=3, 2^4=16=1. Cycle is 4. 31 mod 4 = 3. 2^3 = 8 ≡ 3 (mod 5).",
      "steps": [
        "Cycle length = 4.",
        "31 = 4*7 + 3.",
        "Remainder = 2^3 mod 5 = 3."
      ],
      "methods": [
        {
          "name": "Cyclicity",
          "steps": [
            "2^4 ≡ 1 mod 5 -> 2^31 = (2^4)^7 * 2^3 ≡ 1 * 8 ≡ 3 mod 5."
          ]
        }
      ],
      "exam_tip": "Use cyclicity of modular powers."
    }
  },
  {
