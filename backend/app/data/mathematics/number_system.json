    "subject": "mathematics",
    "topic": "number_system",
    "difficulty": 2,
    "question": "What is the unit digit of 7^95 - 3^58?",
    "options": [
      {
        "id": "A",
        "text": "0"
      },
      {
        "id": "B",
        "text": "4"
      },
      {
        "id": "C",
        "text": "6"
      },
      {
        "id": "D",
        "text": "7"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Cyclicity of 7 is 4: 95 mod 4 = 3 -> 7^3 ends in 3. Cyclicity of 3 is 4: 58 mod 4 = 2 -> 3^2 ends in 9. Unit digit = 13 - 9 = 4.",
      "steps": [
        "7^95 ends in 3.",
        "3^58 ends in 9.",
        "13 - 9 = 4."
      ],
      "methods": [
        {
          "name": "Cyclicity",
          "steps": [
            "7^3 -> 3, 3^2 -> 9 -> (13 - 9) = 4."
          ]
        }
      ],
      "exam_tip": "When minuend unit digit is smaller, add 10 (borrow)."
    }
