[
  {
    "id": "MATH-SI-001",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 1,
    "question": "Find the simple interest on Rs. 5,000 at 8% per annum for 3 years.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 1,000"
      },
      {
        "id": "B",
        "text": "Rs. 1,200"
      },
      {
        "id": "C",
        "text": "Rs. 1,400"
      },
      {
        "id": "D",
        "text": "Rs. 1,500"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "SI = (P * R * T) / 100 = (5000 * 8 * 3) / 100 = Rs. 1,200.",
      "steps": [
        "SI = (5000 * 24)/100 = 1200."
      ],
      "methods": [
        {
          "name": "Formula",
          "steps": [
            "SI = PRT/100 = 1200."
          ]
        }
      ],
      "exam_tip": "Multiply rate and time first: 8 * 3 = 24%. 24% of 5000 = 1200."
    }
  },
  {
    "id": "MATH-SI-002",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 1,
    "question": "In how many years will a sum of money double itself at 10% per annum simple interest?",
    "options": [
      {
        "id": "A",
        "text": "8 years"
      },
      {
        "id": "B",
        "text": "10 years"
      },
      {
        "id": "C",
        "text": "12 years"
      },
      {
        "id": "D",
        "text": "15 years"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "To double, interest earned equals principal (100%). T = 100 / R = 100 / 10 = 10 years.",
      "steps": [
        "SI = P.",
        "P = (P * 10 * T)/100 -> T = 10."
      ],
      "methods": [
        {
          "name": "Rule of Doubling",
          "steps": [
            "T = 100 / R = 10 years."
          ]
        }
      ],
      "exam_tip": "T = 100 / R for simple interest doubling."
    }
  },
  {
    "id": "MATH-SI-003",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 1,
    "question": "Find the compound interest on Rs. 10,000 at 10% per annum for 2 years compounded annually.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 2,000"
      },
      {
        "id": "B",
        "text": "Rs. 2,100"
      },
      {
        "id": "C",
        "text": "Rs. 2,200"
      },
      {
        "id": "D",
        "text": "Rs. 2,250"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Effective rate for 2 years at 10% is 10 + 10 + (10*10)/100 = 21%. CI = 21% of 10,000 = Rs. 2,100.",
      "steps": [
        "Year 1 interest = 1000.",
        "Year 2 interest = 1000 + 100 = 1100.",
        "Total CI = 2100."
      ],
      "methods": [
        {
          "name": "Effective Rate",
          "steps": [
            "10 + 10 + 1 = 21% of 10000 = 2100."
          ]
        }
      ],
      "exam_tip": "Effective CI rate for 2 yrs at r% is 2r + r^2/100."
    }
  },
  {
    "id": "MATH-SI-004",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 1,
    "question": "What is the principal if simple interest at 5% per annum for 4 years is Rs. 600?",
    "options": [
      {
        "id": "A",
        "text": "Rs. 2,500"
      },
      {
        "id": "B",
        "text": "Rs. 3,000"
      },
      {
        "id": "C",
        "text": "Rs. 3,200"
      },
      {
        "id": "D",
        "text": "Rs. 3,500"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Rate * Time = 5 * 4 = 20%. 20% of P = 600 -> P = 600 * 5 = Rs. 3,000.",
      "steps": [
        "0.20 * P = 600 -> P = 3000."
      ],
      "methods": [
        {
          "name": "Unitary",
          "steps": [
            "20% = 600 -> 100% = 3000."
          ]
        }
      ],
      "exam_tip": "P = (SI * 100)/(R * T)."
    }
  },
  {
    "id": "MATH-SI-005",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 2,
    "question": "The difference between CI and SI on Rs. 4,000 for 2 years at 5% per annum is:",
    "options": [
      {
        "id": "A",
        "text": "Rs. 5"
      },
      {
        "id": "B",
        "text": "Rs. 10"
      },
      {
        "id": "C",
        "text": "Rs. 15"
      },
      {
        "id": "D",
        "text": "Rs. 20"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "For 2 years, Difference = P * (R/100)^2 = 4000 * (5/100)^2 = 4000 * 25 / 10000 = Rs. 10.",
      "steps": [
        "Diff = P(R/100)^2 = 4000 * 0.0025 = 10."
      ],
      "methods": [
        {
          "name": "Formula",
          "steps": [
            "Diff = P*(R/100)^2 = 10."
          ]
        }
      ],
      "exam_tip": "2-year difference formula: P * (R/100)^2."
    }
  },
  {
    "id": "MATH-SI-006",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 2,
    "question": "A sum of money doubles itself in 4 years at compound interest. In how many years will it become 8 times?",
    "options": [
      {
        "id": "A",
        "text": "8 years"
      },
      {
        "id": "B",
        "text": "12 years"
      },
      {
        "id": "C",
        "text": "16 years"
      },
      {
        "id": "D",
        "text": "20 years"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "At CI, money grows exponentially. 8 = 2^3. Time = 3 * 4 = 12 years.",
      "steps": [
        "2x in 4 yrs -> 4x in 8 yrs -> 8x in 12 yrs."
      ],
      "methods": [
        {
          "name": "Power Law",
          "steps": [
            "8 = 2^3 -> Time = 3 * 4 = 12 years."
          ]
        }
      ],
      "exam_tip": "If sum becomes n times in T years, it becomes n^k times in k*T years."
    }
  },
  {
    "id": "MATH-SI-007",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 2,
    "question": "At what rate per annum simple interest will Rs. 3,600 amount to Rs. 4,320 in 2 years?",
