  {
    "id": "MATH-SI-017",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 5,
    "question": "A sum of Rs. 16,820 is divided between two sons aged 27 and 25 such that their shares with 5% compound interest will be equal when they reach 40 years. Find the share of the younger son.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 8,000"
      },
      {
        "id": "B",
        "text": "Rs. 8,410"
      },
      {
        "id": "C",
        "text": "Rs. 8,820"
      },
      {
        "id": "D",
        "text": "Rs. 7,800"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "Younger son has 15 years to grow, older son has 13 years. Difference is 2 years. Ratio of shares = (1 + 0.05)^2 = (21/20)^2 = 441 : 400. Sum = 841 units = 16,820 -> 1 unit = 20. Younger son = 400 * 20 = Rs. 8,000.",
      "steps": [
        "Time diff = 2 yrs.",
        "Ratio = (21/20)^2 = 441:400.",
        "Younger = (400/841) * 16820 = 8000."
      ],
      "methods": [
        {
          "name": "Time Ratio",
          "steps": [
            "Younger gets 400 parts out of 841 = 8,000."
          ]
        }
      ],
      "exam_tip": "The younger brother always receives the smaller initial principal."
    }
  },
