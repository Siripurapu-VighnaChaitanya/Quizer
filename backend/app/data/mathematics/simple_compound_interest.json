  {
    "id": "MATH-SI-019",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 5,
    "question": "A person deposited Rs. 500 at the start of each year in a bank giving 10% compound interest per annum. Total amount at end of 3 years is:",
    "options": [
      {
        "id": "A",
        "text": "Rs. 1,655"
      },
      {
        "id": "B",
        "text": "Rs. 1,820.50"
      },
      {
        "id": "C",
        "text": "Rs. 1,750"
      },
      {
        "id": "D",
        "text": "Rs. 1,725"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "1st deposit grows for 3 yrs: 500*(1.331) = 665.5. 2nd deposit for 2 yrs: 500*(1.21) = 605. 3rd deposit for 1 yr: 500*(1.1) = 550. Total = 665.5 + 605 + 550 = Rs. 1,820.50.",
      "steps": [
        "665.5 + 605 + 550 = 1820.50."
      ],
      "methods": [
        {
          "name": "Annuity",
          "steps": [
            "Total = 500 * 1.1 * ((1.1^3 - 1)/0.1) = 1820.50."
          ]
        }
      ],
      "exam_tip": "Calculate each annual deposit separately or use future value of annuity."
    }
  },
  {
