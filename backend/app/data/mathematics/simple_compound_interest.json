  {
    "id": "MATH-SI-009",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 3,
    "question": "A sum amounts to Rs. 6,655 in 3 years and Rs. 7,320.50 in 4 years at compound interest. Find the rate of interest per annum.",
    "options": [
      {
        "id": "A",
        "text": "8%"
      },
      {
        "id": "B",
        "text": "10%"
      },
      {
        "id": "C",
        "text": "12%"
      },
      {
        "id": "D",
        "text": "15%"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "The difference between year 3 and year 4 amounts is 1 year's interest on year 3 amount. Diff = 7320.50 - 6655 = 665.50. Rate = (665.50 / 6655) * 100 = 10%.",
      "steps": [
        "Interest for 4th year = 665.50.",
        "R = (665.50 / 6655)*100 = 10%."
      ],
      "methods": [
        {
          "name": "Consecutive Year Rule",
          "steps": [
            "R = (A4 - A3)/A3 * 100 = 665.5/6655 * 100 = 10%."
          ]
        }
      ],
      "exam_tip": "Consecutive year CI difference divided by earlier year amount gives annual rate directly."
    }
  },
  {
    "id": "MATH-SI-010",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 3,
    "question": "A sum of money invested at simple interest triples itself in 8 years. In how many years will it become 5 times?",
    "options": [
      {
        "id": "A",
        "text": "12 years"
      },
      {
        "id": "B",
        "text": "16 years"
      },
      {
        "id": "C",
        "text": "20 years"
      },
      {
        "id": "D",
        "text": "24 years"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Triples means interest = 2P in 8 years -> 1P interest takes 4 years. To become 5 times, interest needed = 4P -> Time = 4 * 4 = 16 years.",
      "steps": [
        "SI = 2P in 8 yrs -> P takes 4 yrs.",
        "To become 5P, SI = 4P -> 4 * 4 = 16 yrs."
      ],
      "methods": [
        {
          "name": "Formula",
          "steps": [
            "(N1 - 1)/T1 = (N2 - 1)/T2 -> 2/8 = 4/T2 -> T2 = 16."
          ]
        }
      ],
      "exam_tip": "Always subtract 1 from multiple: (N1-1)/T1 = (N2-1)/T2."
    }
  },
  {
    "id": "MATH-SI-011",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 3,
    "question": "If CI on a sum for 2 years at 12.5% per annum is Rs. 510, find the simple interest on the same sum at the same rate and time.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 460"
      },
      {
        "id": "B",
        "text": "Rs. 480"
      },
      {
        "id": "C",
        "text": "Rs. 490"
      },
      {
        "id": "D",
        "text": "Rs. 500"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "12.5% = 1/8. Let P = 8^2 = 64 units. SI per yr = 8 units. Year 1 = 8, Year 2 = 8 + 1 = 9. Total CI = 17 units = 510 -> 1 unit = 30. Total SI = 16 units = 16 * 30 = Rs. 480.",
      "steps": [
        "CI = 17 units = 510 -> unit = 30.",
        "SI = 16 units = 480."
      ],
      "methods": [
        {
          "name": "Tree Method",
          "steps": [
            "P=64: SI=8+8=16, CI=16+1=17. 17 units=510 -> 16 units=480."
          ]
        }
      ],
      "exam_tip": "Tree method with P = (denominator)^2 simplifies fraction percentages."
    }
  },
  {
    "id": "MATH-SI-012",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 3,
    "question": "Rs. 12,000 is divided into two parts such that SI on first at 8% for 5 years equals SI on second at 10% for 4 years. The first part is:",
    "options": [
      {
        "id": "A",
        "text": "Rs. 5,000"
      },
      {
        "id": "B",
        "text": "Rs. 6,000"
      },
      {
        "id": "C",
        "text": "Rs. 7,000"
      },
      {
        "id": "D",
        "text": "Rs. 8,000"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "P1 * 8 * 5 = P2 * 10 * 4 -> 40 P1 = 40 P2 -> P1 = P2. Both parts are equal = 12000 / 2 = Rs. 6,000.",
      "steps": [
        "40 P1 = 40 P2 -> P1 : P2 = 1 : 1.",
        "P1 = 6000."
      ],
      "methods": [
        {
          "name": "Ratio Method",
          "steps": [
            "P1/P2 = (R2*T2)/(R1*T1) = 40/40 = 1:1 -> 6000 each."
          ]
        }
      ],
      "exam_tip": "When interests are equal, P1 : P2 = 1/(R1T1) : 1/(R2T2)."
    }
  },
  {
    "id": "MATH-SI-013",
    "subject": "mathematics",
    "topic": "simple_compound_interest",
    "difficulty": 4,
    "question": "The difference between CI and SI on a sum for 3 years at 10% per annum is Rs. 93. Find the principal sum.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 2,800"
      },
      {
        "id": "B",
        "text": "Rs. 3,000"
      },
      {
        "id": "C",
        "text": "Rs. 3,200"
      },
      {
        "id": "D",
        "text": "Rs. 3,500"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "For 3 years, Difference = P * (R/100)^2 * (300 + R) / 100. 93 = P * (1/100) * (310/100) -> 93 = P * 31 / 1000 -> P = (93 * 1000) / 31 = Rs. 3,000.",
      "steps": [
        "Diff = P * (R^2 * (300+R))/10^6.",
        "93 = P * (100 * 310)/1000000 = P * 31/1000 -> P = 3000."
      ],
      "methods": [
        {
          "name": "Formula",
          "steps": [
            "P = Diff * 1000 / 31 = 93 * 1000 / 31 = 3000."
          ]
        }
      ],
      "exam_tip": "3-year difference formula: P * (R/100)^2 * (3 + R/100)."
    }
  },
  {
