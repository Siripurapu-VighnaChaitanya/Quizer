  {
    "id": "MATH-PL-020",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 5,
    "question": "Sold TV at 5% profit and Fridge at 10% profit for total profit Rs. 2000. If TV at 10% and Fridge at 5%, profit is Rs. 2500. Cost of TV is:",
    "options": [
      {
        "id": "A",
        "text": "Rs. 20,000"
      },
      {
        "id": "B",
        "text": "Rs. 25,000"
      },
      {
        "id": "C",
        "text": "Rs. 30,000"
      },
      {
        "id": "D",
        "text": "Rs. 35,000"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "Adding both gives 0.15(T+F) = 4500 -> T+F = 30000. Subtracting gives 0.05(T-F) = 500 -> T-F = 10000. T = 40000/2 = 20,000.",
      "steps": [
        "T + F = 30,000.",
        "T - F = 10,000.",
        "2T = 40,000 -> T = 20,000."
      ],
      "methods": [
        {
          "name": "Symmetric Addition",
          "steps": [
            "Add and subtract swapped coefficient equations."
          ]
        }
      ],
      "exam_tip": "Add and subtract to decouple variables instantly."
    }
  }
]