  {
    "id": "MATH-PL-005",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 2,
    "question": "By selling an article for Rs. 720, a trader loses 10%. At what price should he sell it to gain 15%?",
    "options": [
      {
        "id": "A",
        "text": "Rs. 880"
      },
      {
        "id": "B",
        "text": "Rs. 900"
      },
      {
        "id": "C",
        "text": "Rs. 920"
      },
      {
        "id": "D",
        "text": "Rs. 940"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "90% of CP = 720 -> CP = 800. Target SP = 115% of 800 = Rs. 920.",
      "steps": [
        "CP = 720 / 0.9 = 800.",
        "New SP = 800 * 1.15 = 920."
      ],
      "methods": [
        {
          "name": "Direct Proportion",
          "steps": [
            "SP2 = (720 / 90) * 115 = 920."
          ]
        }
      ],
      "exam_tip": "SP2 = SP1 * (100 + G2)/(100 - L1)."
    }
  },
  {
    "id": "MATH-PL-006",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 2,
    "question": "A dishonest dealer claims to sell goods at cost price, but uses a false weight of 900 grams for 1 kg. What is his profit percentage?",
    "options": [
      {
        "id": "A",
        "text": "10%"
      },
      {
        "id": "B",
        "text": "11.11%"
      },
      {
        "id": "C",
        "text": "12.5%"
      },
      {
        "id": "D",
        "text": "9.09%"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Profit% = (Error / False Weight) * 100 = (100 / 900) * 100 = 11.11%.",
      "steps": [
        "Error = 1000 - 900 = 100 g.",
        "Profit% = 100/900 * 100 = 11.11%."
      ],
      "methods": [
        {
          "name": "Formula",
          "steps": [
            "Profit% = (100 / 900) * 100 = 11.11%."
          ]
        }
      ],
      "exam_tip": "Denominator is always the actual weight delivered."
    }
  },
  {
    "id": "MATH-PL-007",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 2,
    "question": "If the cost price of 15 pens equals the selling price of 12 pens, find the gain percentage.",
    "options": [
      {
        "id": "A",
        "text": "20%"
      },
      {
        "id": "B",
        "text": "25%"
      },
      {
        "id": "C",
        "text": "30%"
      },
      {
        "id": "D",
        "text": "15%"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "15 CP = 12 SP -> SP/CP = 15/12 = 5/4. Gain = 1 on 4 = 25%.",
      "steps": [
        "SP/CP = 5/4.",
        "Gain% = (1/4)*100 = 25%."
      ],
      "methods": [
        {
          "name": "Formula",
          "steps": [
            "((15 - 12)/12) * 100 = 25%."
          ]
        }
      ],
      "exam_tip": "Formula: ((x - y)/y) * 100%."
    }
  },
  {
    "id": "MATH-PL-008",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 2,
    "question": "A marked price of a shirt is Rs. 1,000. It is offered with two successive discounts of 10% and 20%. What is the net selling price?",
    "options": [
      {
        "id": "A",
        "text": "Rs. 700"
      },
      {
        "id": "B",
        "text": "Rs. 720"
      },
      {
        "id": "C",
        "text": "Rs. 740"
      },
      {
        "id": "D",
        "text": "Rs. 750"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Net discount = 10 + 20 - (10*20)/100 = 28%. SP = 1000 * 0.72 = Rs. 720.",
      "steps": [
        "Discount 1 = 100 -> 900.",
        "Discount 2 = 20% of 900 = 180 -> 720."
      ],
      "methods": [
        {
          "name": "Successive formula",
          "steps": [
            "Net D% = 10 + 20 - 2 = 28% -> SP = 720."
          ]
        }
      ],
      "exam_tip": "Net discount = a + b - ab/100."
    }
  },
  {
    "id": "MATH-PL-009",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 3,
    "question": "A person sells two watches for Rs. 1,980 each. On one he gains 10% and on the other he loses 10%. Find his overall gain or loss percentage.",
    "options": [
      {
        "id": "A",
        "text": "No profit, no loss"
      },
      {
        "id": "B",
        "text": "1% gain"
      },
      {
        "id": "C",
        "text": "1% loss"
      },
      {
        "id": "D",
        "text": "2% loss"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "When SP is same and gain% = loss% = x%, overall loss is (x/10)^2 % = (10/10)^2 = 1% loss.",
      "steps": [
        "Loss% = (x/10)^2 % = 1% loss."
      ],
      "methods": [
        {
          "name": "Shortcut",
          "steps": [
            "10^2 / 100 = 1% loss."
          ]
        }
      ],
      "exam_tip": "Always an overall loss of x^2/100%."
    }
  },
  {
    "id": "MATH-PL-010",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 3,
    "question": "A trader marks his goods 40% above cost price and allows 25% discount. Find his profit percentage.",
    "options": [
      {
        "id": "A",
        "text": "5%"
      },
      {
        "id": "B",
        "text": "8%"
      },
      {
        "id": "C",
        "text": "10%"
      },
      {
        "id": "D",
        "text": "15%"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "Let CP = 100 -> MP = 140. Discount 25% of 140 = 35. SP = 105. Profit% = 5%.",
      "steps": [
        "MP = 140.",
        "SP = 140 * 0.75 = 105.",
        "Profit = 5%."
      ],
      "methods": [
        {
          "name": "Net Effect",
          "steps": [
            "40 - 25 - (40*25)/100 = 15 - 10 = 5%."
          ]
        }
