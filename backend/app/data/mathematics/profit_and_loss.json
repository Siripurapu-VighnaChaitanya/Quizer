  },
  {
    "id": "MATH-PL-011",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 3,
    "question": "A man buys lemons at 6 for Rs. 10 and sells them at 4 for Rs. 9. What is his gain percentage?",
    "options": [
      {
        "id": "A",
        "text": "30%"
      },
      {
        "id": "B",
        "text": "35%"
      },
      {
        "id": "C",
        "text": "40%"
      },
      {
        "id": "D",
        "text": "45%"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Take LCM of 6 and 4 = 12. CP of 12 = 20. SP of 12 = 27. Profit = 7 on 20 = 35%.",
      "steps": [
        "CP(12) = 20.",
        "SP(12) = 27.",
        "Gain% = (7/20)*100 = 35%."
      ],
      "methods": [
        {
          "name": "LCM Method",
          "steps": [
            "LCM(6, 4)=12 -> CP=20, SP=27 -> 35%."
          ]
        }
      ],
      "exam_tip": "Equate quantities to the LCM."
    }
  },
  {
    "id": "MATH-PL-012",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 3,
    "question": "A merchant sells 1/3 of goods at 15% profit, 1/3 at 10% profit and rest at 5% loss. Overall profit% is:",
    "options": [
      {
        "id": "A",
        "text": "6.67%"
      },
      {
        "id": "B",
        "text": "7.5%"
      },
      {
        "id": "C",
        "text": "8.33%"
      },
      {
        "id": "D",
        "text": "5%"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "Average of profits: (15 + 10 - 5) / 3 = 20 / 3 = 6.67%.",
      "steps": [
        "P% = (15 + 10 - 5)/3 = 20/3 = 6.67%."
      ],
      "methods": [
        {
          "name": "Weighted Average",
          "steps": [
            "(15 + 10 - 5)/3 = 6.67%."
          ]
        }
      ],
      "exam_tip": "When fractions are equal, take arithmetic mean."
    }
  },
  {
    "id": "MATH-PL-013",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 4,
    "question": "A shopkeeper sells an article at 12.5% loss. If he had sold it for Rs. 51.80 more, he would gain 6%. Find CP.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 260"
      },
      {
        "id": "B",
        "text": "Rs. 280"
      },
      {
        "id": "C",
        "text": "Rs. 300"
      },
      {
        "id": "D",
        "text": "Rs. 320"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Total gap = 12.5% + 6% = 18.5%. 18.5% of CP = 51.80 -> CP = 51.80 / 0.185 = Rs. 280.",
      "steps": [
        "Gap% = 18.5%.",
        "CP = 51.80 / 0.185 = 280."
      ],
      "methods": [
        {
          "name": "Gap Method",
          "steps": [
            "CP = (Diff / Total%) * 100 = (51.80 / 18.5) * 100 = 280."
          ]
        }
      ],
      "exam_tip": "Add loss% and gain% to get the difference."
    }
  },
  {
    "id": "MATH-PL-014",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 4,
    "question": "A dealer sells at 10% profit. If he bought at 10% less and sold for Rs. 16 more, he would gain 25%. Find initial CP.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 640"
      },
      {
        "id": "B",
        "text": "Rs. 600"
      },
      {
        "id": "C",
        "text": "Rs. 500"
      },
      {
        "id": "D",
        "text": "Rs. 400"
      }
    ],
    "correct_option": "A",
    "explanation": {
      "simple": "Let CP = 100 -> SP1 = 110. New CP = 90 -> SP2 = 90 * 1.25 = 112.5. Diff = 2.5 units = 16 -> 100 units = Rs. 640.",
      "steps": [
        "SP1 = 110x, SP2 = 112.5x.",
        "2.5x = 16 -> 100x = 640."
      ],
      "methods": [
        {
          "name": "Unit Method",
          "steps": [
            "100 -> 110. 90 -> 112.5. Diff = 2.5 = 16 -> 100 = 640."
          ]
        }
      ],
      "exam_tip": "Use 100 base units for rapid solution."
    }
  },
  {
    "id": "MATH-PL-015",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 4,
    "question": "Profit by selling for Rs. 832 equals loss by selling for Rs. 448. Selling price for 50% profit is:",
    "options": [
      {
        "id": "A",
        "text": "Rs. 920"
      },
      {
        "id": "B",
        "text": "Rs. 940"
      },
      {
        "id": "C",
        "text": "Rs. 960"
      },
      {
        "id": "D",
        "text": "Rs. 980"
      }
    ],
    "correct_option": "C",
    "explanation": {
      "simple": "CP = (832 + 448) / 2 = 640. SP for 50% profit = 640 * 1.5 = Rs. 960.",
      "steps": [
        "CP = (832 + 448)/2 = 640.",
        "SP = 640 * 1.5 = 960."
      ],
      "methods": [
        {
          "name": "Midpoint Rule",
          "steps": [
            "CP = (SP1 + SP2)/2 = 640. 50% profit SP = 960."
          ]
        }
      ],
      "exam_tip": "When profit = loss, CP is the average of the two selling prices."
    }
  },
  {
    "id": "MATH-PL-016",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 4,
    "question": "A trader gives 1 free article with every 4 bought and also gives 20% discount. Total discount% is:",
