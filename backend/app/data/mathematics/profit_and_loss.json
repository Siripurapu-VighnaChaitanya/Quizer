[
  {
    "id": "MATH-PL-001",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 1,
    "question": "A shopkeeper buys an article for Rs. 400 and sells it for Rs. 500. What is his profit percentage?",
    "options": [
      {
        "id": "A",
        "text": "20%"
      },
      {
        "id": "B",
        "text": "25%"
      },
      {
        "id": "C",
        "text": "30%"
      },
      {
        "id": "D",
        "text": "15%"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Profit = 500 - 400 = 100. Profit% = (100 / 400) * 100 = 25%.",
      "steps": [
        "Profit = SP - CP = Rs. 100.",
        "Profit% = (100/400)*100 = 25%."
      ],
      "methods": [
        {
          "name": "Direct Ratio",
          "steps": [
            "CP:SP = 4:5 -> Gain = 1/4 = 25%"
          ]
        }
      ],
      "exam_tip": "Profit% is always calculated on CP."
    }
  },
  {
    "id": "MATH-PL-002",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 1,
    "question": "If an item costing Rs. 250 is sold at a loss of 10%, find the selling price.",
    "options": [
      {
        "id": "A",
        "text": "Rs. 220"
      },
      {
        "id": "B",
        "text": "Rs. 225"
      },
      {
        "id": "C",
        "text": "Rs. 230"
      },
      {
        "id": "D",
        "text": "Rs. 215"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "Loss = 10% of 250 = Rs. 25. SP = 250 - 25 = Rs. 225.",
      "steps": [
        "Loss = Rs. 25.",
        "SP = CP - Loss = 225."
      ],
      "methods": [
        {
          "name": "Multiplier",
          "steps": [
            "SP = 250 * 0.90 = Rs. 225."
          ]
        }
      ],
      "exam_tip": "SP = CP * (100 - Loss%)/100."
    }
  },
  {
    "id": "MATH-PL-003",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 1,
    "question": "An article is sold for Rs. 660 at a profit of 10%. What was its cost price?",
    "options": [
      {
        "id": "A",
        "text": "Rs. 580"
      },
      {
        "id": "B",
        "text": "Rs. 600"
      },
      {
        "id": "C",
        "text": "Rs. 610"
      },
      {
        "id": "D",
        "text": "Rs. 590"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "110% of CP = 660 -> CP = (660 * 100) / 110 = Rs. 600.",
      "steps": [
        "1.1 * CP = 660",
        "CP = 600."
      ],
      "methods": [
        {
          "name": "Ratio",
          "steps": [
            "10% profit -> CP:SP = 10:11. 11 units = 660 -> 10 units = 600."
          ]
        }
      ],
      "exam_tip": "Express percentage as ratio for faster mental math."
    }
  },
  {
