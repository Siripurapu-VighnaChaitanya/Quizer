  {
    "id": "MATH-PL-019",
    "subject": "mathematics",
    "topic": "profit_and_loss",
    "difficulty": 5,
    "question": "Article sold at 20% profit. If CP rises by Rs. 50 and SP rises by Rs. 30, profit becomes 10%. Original CP was:",
    "options": [
      {
        "id": "A",
        "text": "Rs. 200"
      },
      {
        "id": "B",
        "text": "Rs. 250"
      },
      {
        "id": "C",
        "text": "Rs. 300"
      },
      {
        "id": "D",
        "text": "Rs. 350"
      }
    ],
    "correct_option": "B",
    "explanation": {
      "simple": "1.2x + 30 = 1.1(x + 50) -> 1.2x + 30 = 1.1x + 55 -> 0.1x = 25 -> x = Rs. 250.",
